<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Se hereda del starter parent de Spring Boot. El parent administra las
    versiones de todas las dependencias, por eso spring-kafka se declara mas
    abajo sin numero de version: la toma de aqui.

    Se mantiene la misma version 3.3.5 que usan los otros microservicios de la
    plataforma, para que todos los modulos compilen con el mismo arbol de
    dependencias.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>cl.innovatech</groupId>
  <artifactId>ms-kafka</artifactId>
  <version>1.0.0</version>
  <name>Microservicio de Administracion y Observabilidad de Kafka</name>
  <description>Innovatech Chile - Administracion de topics, particiones, offsets y grupos consumidores del cluster de Apache Kafka</description>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <!-- Spring Web: expone los endpoints REST del productor y de consulta. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!--
      Spring for Apache Kafka: aporta KafkaTemplate (productor),
      @KafkaListener (consumidor) y KafkaAdmin (administracion del cluster).
      Arrastra kafka-clients, que es la libreria oficial de Apache.
    -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>

    <!-- Bean Validation: valida los parametros antes de publicar al broker. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Pruebas -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
